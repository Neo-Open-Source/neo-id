generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  emailVerified Boolean   @default(false)
  username      String?   @unique
  passwordHash  String?
  displayName   String?
  firstName     String?
  lastName      String?
  avatar        String?
  role          String    @default("user") // user | developer | admin
  status        String    @default("active") // active | banned | invited

  // Metadata (Auth0 pattern)
  userMetadata  Json?     @default("{}")
  appMetadata   Json?     @default("{}")

  // MFA
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  emailMfaEnabled Boolean  @default(false)

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  lastLoginIp   String?

  // Relations
  sessions      Session[]
  refreshTokens RefreshToken[]
  serviceApps   ServiceApp[]
  identities    Identity[]
  passkeys      Passkey[]
  mfaCodes      MfaCode[]

  @@map("users")
}

// ─── Session ─────────────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device info
  deviceInfo   String?
  ipAddress    String?
  location     String?  // GeoIP city/country

  // Status
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime?

  @@index([userId])
  @@map("sessions")
}

// ─── Refresh Token ───────────────────────────────────────────────────────────

model RefreshToken {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?   @db.ObjectId

  // Token
  tokenHash     String    @unique // Index created by @unique
  parentId      String?   @db.ObjectId // For reuse detection chain

  // Device
  deviceInfo    String?
  ipAddress     String?

  // Timestamps
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime?

  // Revocation
  revokedAt     DateTime?
  revokeReason  String?

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Service App ─────────────────────────────────────────────────────────────

model ServiceApp {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId         String   @db.ObjectId
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Identity
  clientId        String   @unique // Index created by @unique
  clientSecretHash String?
  name            String
  displayName     String?
  description     String?
  logoUrl         String?
  website         String?

  // OAuth config
  redirectUris    String[]
  allowedScopes   String[] @default(["openid", "profile", "email"])
  grantTypes      String[] @default(["authorization_code", "refresh_token"])

  // Status
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@map("service_apps")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model Identity {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider        String   // "google", "github"
  providerUserId  String
  accessToken     String?
  refreshToken    String?

  createdAt       DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

// ─── Passkey ─────────────────────────────────────────────────────────────────

model Passkey {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentialId    String   @unique
  publicKey       String
  counter         Int      @default(0)
  transports      String?
  deviceName      String?

  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
  @@map("passkeys")
}

// ─── OAuth State ─────────────────────────────────────────────────────────────

model OAuthState {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  state           String   @unique // Index created by @unique
  codeVerifier    String?
  codeChallenge   String?
  redirectUri     String?
  serviceAppId    String?  @db.ObjectId
  userId          String?  @db.ObjectId

  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@map("oauth_states")
}

// ─── MFA Code ────────────────────────────────────────────────────────────────

model MfaCode {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String
  purpose         String   // "login", "email_change", "delete_account"

  createdAt       DateTime @default(now())
  expiresAt       DateTime
  usedAt          DateTime?

  @@index([userId, purpose])
  @@map("mfa_codes")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId         String
  actorEmail      String
  action          String
  targetId        String?
  targetEmail     String?
  details         Json?
  ipAddress       String?

  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
