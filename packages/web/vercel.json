{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @neo-id/db exec prisma db push && pnpm --filter @neo-id/db exec prisma generate && pnpm turbo run build --filter=@neo-id/web...",
  "devCommand": "pnpm run dev",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/api/v1/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/avatars/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
