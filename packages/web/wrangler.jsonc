{
  "name": "neo-id-web",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "id.neome.uk/*", "zone_name": "neome.uk" }
  ],
  // "main" (vinext worker entry) is generated by `vinext init`; do not hand-write it.
  // Domain routes are managed in the Cloudflare dashboard, see CF_MIGRATION.md:
  // web worker <- id.neome.uk/* | api worker <- id.neome.uk/api/*, id.neome.uk/.well-known/*
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://id.neome.uk",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": ""
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0,
      "invocation_logs": false
    }
  }
,
  "main": "vinext/server/fetch-handler"
}
