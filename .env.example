# ── Database (PostgreSQL via Prisma) ───────────────
# For remote DBs with self-signed certs, append: ?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/neo-id

# ── JWT (RS256) ───────────────────────────────────
# Generate with: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://id.neome.uk

# ── URLs ──────────────────────────────────────────
BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000

# ── OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

WEB_URL=http://localhost:3001

# ── Email (Resend) ────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Neo ID <no-reply@neome.uk>"

# ── Security ──────────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── API ───────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=*

# ── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
# EXTERNAL_API=http://localhost:3000  # Uncomment to proxy /api/* to a separate API server
