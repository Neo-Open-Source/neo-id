# ── Database ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/neo-id

# ── JWT (RS256 — generate with: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem) ──
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=https://id.neome.uk

# ── URLs ─────────────────────────────────────────────
BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000

# ── OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback/google

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback/github

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Neo ID <no-reply@neome.uk>"

# ── Security ─────────────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── API ──────────────────────────────────────────────
API_PORT=3000
CORS_ORIGIN=*

# ── Frontend ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
