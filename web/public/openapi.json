{
  "openapi": "3.1.0",
  "info": {
    "title": "Neo ID API",
    "version": "0.1.0",
    "description": "Unified identity, OAuth 2.0 / OpenID Connect, MFA, sessions and service integration API."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current environment"
    }
  ],
  "tags": [
    { "name": "OIDC" },
    { "name": "Consent" },
    { "name": "Auth" },
    { "name": "User" },
    { "name": "MFA" },
    { "name": "Sessions" },
    { "name": "Services" },
    { "name": "Admin" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        },
        "required": ["error"]
      }
    }
  },
  "paths": {
    "/.well-known/openid-configuration": {
      "get": {
        "tags": ["OIDC"],
        "summary": "OIDC discovery document",
        "responses": { "200": { "description": "Discovery document" } }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": ["OIDC"],
        "summary": "JWKS public keys",
        "responses": { "200": { "description": "JWKS response" } }
      }
    },
    "/oauth/authorize": {
      "get": {
        "tags": ["OIDC"],
        "summary": "Start authorization flow",
        "parameters": [
          { "name": "client_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "redirect_uri", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "response_type", "in": "query", "required": true, "schema": { "type": "string", "example": "code" } },
          { "name": "scope", "in": "query", "required": true, "schema": { "type": "string", "example": "openid profile email" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "nonce", "in": "query", "schema": { "type": "string" } },
          { "name": "code_challenge", "in": "query", "schema": { "type": "string" } },
          { "name": "code_challenge_method", "in": "query", "schema": { "type": "string", "example": "S256" } },
          { "name": "mode", "in": "query", "schema": { "type": "string", "example": "popup" } }
        ],
        "responses": { "302": { "description": "Redirect to login or consent" } }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": ["OIDC"],
        "summary": "Exchange authorization code for tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": { "type": "string", "example": "authorization_code" },
                  "code": { "type": "string" },
                  "client_id": { "type": "string" },
                  "client_secret": { "type": "string" },
                  "redirect_uri": { "type": "string" }
                },
                "required": ["grant_type", "code", "client_id", "client_secret", "redirect_uri"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token response" },
          "400": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/oauth/consent-info": {
      "get": {
        "tags": ["Consent"],
        "summary": "Get consent session information",
        "parameters": [
          { "name": "session", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Consent info" } }
      }
    },
    "/api/oauth/consent": {
      "post": {
        "tags": ["Consent"],
        "summary": "Approve or deny consent request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session": { "type": "string" },
                  "approved": { "type": "boolean" }
                },
                "required": ["session", "approved"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Consent result" } }
      }
    },
    "/api/auth/login/password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Email and password login",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Login result" } }
      }
    },
    "/api/auth/register/password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register with email and password",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Registration result" } }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Refreshed tokens" } }
      }
    },
    "/api/user/profile": {
      "get": {
        "tags": ["User"],
        "summary": "Get current user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Profile" } }
      }
    },
    "/api/user/providers": {
      "get": {
        "tags": ["User"],
        "summary": "List linked OAuth providers",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Providers list" } }
      }
    },
    "/api/user/services": {
      "get": {
        "tags": ["Services"],
        "summary": "List connected and available services",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Services list" } }
      }
    },
    "/api/user/mfa/totp/setup": {
      "post": {
        "tags": ["MFA"],
        "summary": "Start TOTP setup",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "TOTP setup payload" } }
      }
    },
    "/api/user/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "List active sessions",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Sessions list" } }
      }
    },
    "/api/service/login": {
      "post": {
        "tags": ["Services"],
        "summary": "Create site login URL",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Login URL response" } }
      }
    },
    "/api/service/verify": {
      "post": {
        "tags": ["Services"],
        "summary": "Verify service token",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Verification result" } }
      }
    },
    "/api/admin/clients": {
      "get": {
        "tags": ["Admin"],
        "summary": "List OIDC clients",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Clients list" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create OIDC client",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Client created" } }
      }
    }
  }
}
